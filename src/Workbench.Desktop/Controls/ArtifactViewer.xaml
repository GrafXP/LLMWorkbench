<UserControl x:Class="Workbench.Desktop.Controls.ArtifactViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Workbench.Desktop.Controls">
  <Grid Background="{StaticResource Panel}" Margin="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,5">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Command="{Binding PreviousResultCommand}" ToolTip="Previous result" /><Button Content="›" Command="{Binding NextResultCommand}" ToolTip="Next result" /></StackPanel>
      <TextBlock Text="{Binding ViewerTitle}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>
    <TextBlock Grid.Row="1" Text="{Binding ViewerDetail}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
    <Grid Grid.Row="2" Visibility="{Binding ViewerImageVisibility}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,4">
        <Button Content="Fit" Click="FitImage" /><Button Content="100%" Click="ActualImage" /><Button Content="−" Click="ZoomOut" /><Button Content="＋" Click="ZoomIn" />
        <TextBlock x:Name="ZoomLabel" VerticalAlignment="Center" Margin="8,0" />
      </WrapPanel>
      <ctrl:ZoomImage Grid.Row="1" x:Name="ImageView" Source="{Binding ViewerImage}" MinHeight="80" />
      <TextBlock Grid.Row="2" Text="Scroll to zoom · drag to pan · double-click to fit" Style="{StaticResource Caption}" Margin="0,5" />
      <Expander Grid.Row="3" Header="Prompt and source text" Foreground="{StaticResource Text}">
        <StackPanel>
          <TextBox Text="{Binding ViewerImageText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="130" />
          <WrapPanel><Button Content="Edit source text" Command="{Binding EditSourceTextCommand}" /><Button Content="Edit prepared prompt" Command="{Binding EditPreparedPromptCommand}" /></WrapPanel>
        </StackPanel>
      </Expander>
    </Grid>
    <Grid Grid.Row="2" Visibility="{Binding ViewerTextVisibility}">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TextBox x:Name="TextEditor" Text="{Binding ViewerText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ViewerReadOnly}"
               AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
      <WrapPanel Grid.Row="1" Margin="0,6,0,0">
        <Button Content="Save text edits" Command="{Binding SaveViewerCommand}" />
        <Button Content="Run downstream with edits" Command="{Binding RunViewerCommand}" Background="#24536C" />
      </WrapPanel>
    </Grid>
    <TextBlock Grid.Row="2" Text="Select a text draft or a result to view it here." Visibility="{Binding ViewerEmptyVisibility}"
               Foreground="{StaticResource Muted}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" />
    <TextBlock Grid.Row="3" Text="{Binding ViewerStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
  </Grid>
</UserControl>
