<Application x:Class="Workbench.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="Themes/DarkChrome.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="Panel" Color="#1D2633" />
    <SolidColorBrush x:Key="Input" Color="#141A23" />
    <SolidColorBrush x:Key="Text" Color="#E4ECF6" />
    <SolidColorBrush x:Key="Muted" Color="#94A3B8" />
    <SolidColorBrush x:Key="Accent" Color="#69B9FF" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="FontFamily" Value="Segoe UI" /></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="11" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2B3A4D" /><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="BorderBrush" Value="#435064" />
      <Setter Property="Padding" Value="10,6" /><Setter Property="Margin" Value="2" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#39516D" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource Input}" /><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="CaretBrush" Value="{StaticResource Text}" /><Setter Property="BorderBrush" Value="#435064" /><Setter Property="Padding" Value="8" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="Margin" Value="4" /></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource Panel}" /><Setter Property="BorderBrush" Value="#354359" /></Style>
    <Style TargetType="TabItem"><Setter Property="Background" Value="#2B3A4D" /><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="Padding" Value="12,6" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Header" Background="{TemplateBinding Background}" BorderBrush="#435064" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Header" Property="Background" Value="#24536C" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="Background" Value="{StaticResource Input}" /><Setter Property="Padding" Value="8,5" /><Setter Property="BorderBrush" Value="#435064" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{StaticResource Input}" BorderBrush="#435064" BorderThickness="1" CornerRadius="3"><TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8" /></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" /><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{StaticResource Panel}" BorderBrush="#435064" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"><ScrollViewer MaxHeight="300"><ItemsPresenter /></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="Background" Value="{StaticResource Panel}" /><Setter Property="Padding" Value="8,5" /></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="{StaticResource Panel}" /><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></Style>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="Padding" Value="2" /></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="{StaticResource Panel}" /><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="RowBackground" Value="{StaticResource Panel}" /><Setter Property="AlternatingRowBackground" Value="#263244" /><Setter Property="BorderThickness" Value="0" /><Setter Property="GridLinesVisibility" Value="None" /><Setter Property="HeadersVisibility" Value="Column" /><Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="IsReadOnly" Value="True" /><Setter Property="CanUserAddRows" Value="False" /></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#2B3748" /><Setter Property="Foreground" Value="{StaticResource Text}" /><Setter Property="Padding" Value="8,6" /><Setter Property="BorderThickness" Value="0" /></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
